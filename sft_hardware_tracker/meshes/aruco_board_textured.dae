<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor>
      <authoring_tool>sft_hardware_tracker</authoring_tool>
    </contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>

  <library_images>
    <image id="aruco_board_image" name="aruco_board_image">
      <init_from>../materials/textures/aruco_board.png</init_from>
    </image>
  </library_images>

  <library_effects>
    <effect id="aruco_board_effect">
      <profile_COMMON>
        <newparam sid="aruco_board_surface">
          <surface type="2D">
            <init_from>aruco_board_image</init_from>
          </surface>
        </newparam>
        <newparam sid="aruco_board_sampler">
          <sampler2D>
            <source>aruco_board_surface</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
            <minfilter>LINEAR</minfilter>
            <magfilter>LINEAR</magfilter>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <diffuse>
              <texture texture="aruco_board_sampler" texcoord="UVSET0"/>
            </diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

  <library_materials>
    <material id="aruco_board_material" name="aruco_board_material">
      <instance_effect url="#aruco_board_effect"/>
    </material>
  </library_materials>

  <library_geometries>
    <geometry id="aruco_board_geometry" name="aruco_board_geometry">
      <mesh>
        <source id="aruco_board_positions">
          <float_array id="aruco_board_positions_array" count="12">
            -0.15 -0.15 0.0
             0.15 -0.15 0.0
             0.15  0.15 0.0
            -0.15  0.15 0.0
          </float_array>
          <technique_common>
            <accessor source="#aruco_board_positions_array" count="4" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <source id="aruco_board_normals">
          <float_array id="aruco_board_normals_array" count="3">0.0 0.0 1.0</float_array>
          <technique_common>
            <accessor source="#aruco_board_normals_array" count="1" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <source id="aruco_board_texcoords">
          <float_array id="aruco_board_texcoords_array" count="8">
            0.0 0.0
            1.0 0.0
            1.0 1.0
            0.0 1.0
          </float_array>
          <technique_common>
            <accessor source="#aruco_board_texcoords_array" count="4" stride="2">
              <param name="S" type="float"/>
              <param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>

        <vertices id="aruco_board_vertices">
          <input semantic="POSITION" source="#aruco_board_positions"/>
        </vertices>

        <triangles material="aruco_board_material" count="2">
          <input semantic="VERTEX" source="#aruco_board_vertices" offset="0"/>
          <input semantic="NORMAL" source="#aruco_board_normals" offset="1"/>
          <input semantic="TEXCOORD" source="#aruco_board_texcoords" offset="2" set="0"/>
          <p>
            0 0 0  1 0 1  2 0 2
            0 0 0  2 0 2  3 0 3
          </p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>

  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="aruco_board_node" name="aruco_board_node">
        <instance_geometry url="#aruco_board_geometry">
          <bind_material>
            <technique_common>
              <instance_material symbol="aruco_board_material" target="#aruco_board_material">
                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0"/>
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>

  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
